@@ -487,7 +492,23 @@
   assign S_AXI_HP0_RID = S_AXI_HP0_RID_TMP;
   assign S_AXI_HP0_BID = S_AXI_HP0_BID_TMP;
 
+wire emmc_cmd_i, emmc_cmd_o, emmc_cmd_t;
+wire [3:0] emmc_data_i, emmc_data_o, emmc_data_t;
+IOBUF emmc_cmd_iobuf(.I(emmc_cmd_o), .O(emmc_cmd_i), .T(emmc_cmd_t), .IO(emmc_cmd));
+PULLUP emmc_cmd_pullup(.O(emmc_cmd));
+genvar emmc_bit;
+generate for(emmc_bit=0; emmc_bit<4; emmc_bit=emmc_bit+1) begin: emmc_iobufs
+    IOBUF data_iobuf(.I(emmc_data_o[emmc_bit]), .O(emmc_data_i[emmc_bit]),
+        .T(emmc_data_t[emmc_bit]), .IO(emmc_data[emmc_bit]));
+    PULLUP data_pullup(.O(emmc_data[emmc_bit]));
+end endgenerate
 ps_ai ps_ai_i(
+  .SDIO_1_0_clk(emmc_clk), .SDIO_1_0_clk_fb(emmc_clk),
+  .SDIO_1_0_cmd_i(emmc_cmd_i), .SDIO_1_0_cmd_o(emmc_cmd_o), .SDIO_1_0_cmd_t(emmc_cmd_t),
+  .SDIO_1_0_data_i(emmc_data_i), .SDIO_1_0_data_o(emmc_data_o), .SDIO_1_0_data_t(emmc_data_t),
+  .SDIO_1_0_cdn(1'b0), .SDIO_1_0_wp(1'b0),
+  .SDIO_1_0_buspow(), .SDIO_1_0_busvolt(), .SDIO_1_0_led(),
+
   .BYolo_GP0_araddr                   (BYolo_GP0_ARADDR                   ),
   .BYolo_GP0_arburst                  (BYolo_GP0_ARBURST                  ),
   .BYolo_GP0_arcache                  (BYolo_GP0_ARCACHE                  ),
